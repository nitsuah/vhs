{
  "name": "vhs-shelf-scanner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint --config ./.eslintrc.json src/server.js",
    "test": "NODE_ENV=test jest",
    "test:ui": "playwright test",
    "test:journeys": "playwright test --config config/playwright.journeys.config.js",
    "capture:screenshots": "DOCS_SCREENSHOTS=docs/screenshots playwright test --config config/playwright.journeys.config.js --ignore-snapshots --retries 0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^11.0.2",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
