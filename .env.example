# ── Web UI port ───────────────────────────────────────────────────────────────
APP_PORT=8080

# ── HTTPS / mobile camera access ─────────────────────────────────────────────
# Set to your machine's LAN IP so the auto-generated TLS cert covers it.
# Then open http://<HOST_IP>:8080/api/ca-cert on your phone to download the CA cert.
# That download is plain HTTP: before trusting it, compare its SHA-256 fingerprint on
# the phone with the one printed on the host by
#   docker compose -f config/docker-compose.yml exec web openssl x509 -in /app/certs/ca.crt -noout -fingerprint -sha256
# (see README "Mobile / HTTPS setup"). Then use https://<HOST_IP>:8443 for camera access.
HOST_IP=192.168.1.171

# ── Vision model ──────────────────────────────────────────────────────────────
OLLAMA_MODEL=llava:7b

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Ollama upstream ───────────────────────────────────────────────────────────
OLLAMA_UPSTREAM=http://ollama:11434
# OLLAMA_UPSTREAM=http://host.docker.internal:11434   # native Windows Ollama with GPU

# ── OMDb (optional) ───────────────────────────────────────────────────────────
# Free key at https://www.omdbapi.com/apikey.aspx
# OMDB_API_KEY=        # OMDb API key for movie metadata lookups (also accepted per request as x-omdb-key)
# TMDB_KEY=your_tmdb_api_key_here   # TMDb API key for movie metadata lookups (also accepted per request as x-tmdb-key)

# ── eBay Browse API (optional — sold-listing valuation) ──────────────────────
# Create an app at https://developer.ebay.com/my/keys and use the App ID (Client ID)
# and Cert ID (Client Secret). Leave blank to disable the 🛒 eBay button
# (the endpoint then returns 503 instead of failing silently).
# EBAY_CLIENT_ID=        # eBay App ID (Client ID) for the Browse API
# EBAY_CLIENT_SECRET=    # eBay Cert ID (Client Secret) paired with the App ID
# production | sandbox
EBAY_ENVIRONMENT=production
# EBAY_MARKETPLACE_ID=EBAY_US   # eBay marketplace used for sold-listing lookups

# ── Google OAuth (optional — leave blank to disable auth) ────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI: <APP_BASE_URL>/auth/google/callback
#    e.g. http://localhost:8080/auth/google/callback (live: https://vhsbox.netlify.app/auth/google/callback)
# Sign-in is enabled only when BOTH values are set.
# GOOGLE_CLIENT_ID=      # OAuth 2.0 Web client ID from Google Cloud Console
# GOOGLE_CLIENT_SECRET=  # OAuth 2.0 client secret for that Web client

# ── JWT session secret ────────────────────────────────────────────────────────
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when Google sign-in is enabled; signs the 7-day session cookie.
# JWT_SECRET=            # random string used to sign and verify session JWTs

# ── App base URL (used to build the OAuth redirect URI) ──────────────────────
# Local:   http://localhost:8080
# Netlify: https://your-site.netlify.app
APP_BASE_URL=http://localhost:8080

# ── Legacy tape ownership (one-time migration) ────────────────────────────────
# On first Google login with this email, all tapes with no owner are automatically
# claimed. Safe to leave set permanently — becomes a no-op once claimed.
# LEGACY_OWNER_EMAIL=you@gmail.com   # Google account that claims all unowned tapes on first login
