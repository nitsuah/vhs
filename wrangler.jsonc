{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vhsbox",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/auth/*", "/health", "/c/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // Non-secret config. Secrets (DATABASE_URL, JWT_SECRET, GOOGLE_*, EBAY_*,
  // OMDB_API_KEY, TMDB_KEY, ...) are set with `wrangler secret put`, never here.
  "vars": {
    "NODE_ENV": "production",
    "VISION_BACKEND": "workers-ai",
    "VISION_DAILY_CAP": "200"
  }
}
