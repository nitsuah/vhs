{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vhsbox",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/health"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true },
  // Non-secret config. Secrets (DATABASE_URL, JWT_SECRET, GOOGLE_*, EBAY_*,
  // OMDB_API_KEY, TMDB_KEY, ...) are set with `wrangler secret put`, never here.
  "vars": { "NODE_ENV": "production" }
}
